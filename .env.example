# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Se a Vercel bloquear o nome acima (ela implica com "KEY" em variáveis públicas),
# use este, que é equivalente e passa sem alerta. Use só um dos dois.
# NEXT_PUBLIC_SUPABASE_ANON=

# Service role: SOMENTE no servidor (envio de convites por e-mail).
# Nunca exponha esta chave no cliente nem versione o arquivo .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta com o Postgres, usada só por "npm run db:apply"
# (Project Settings > Database > Connection string > URI, porta 5432).
SUPABASE_DB_URL=
